# ── The legacy shop (docker compose up --build in ../legacy-shop) ──────────────
SHOPMASTER_BASE_URL=http://localhost:8080/legacy
SHOPMASTER_USER=svc_agent
SHOPMASTER_PASS=Winter2009!

# ── The LLM: Groq (free key at https://console.groq.com/keys) ──────────────────
GROQ_API_KEY=<your-groq-key>
LLM_MODEL=openai/gpt-oss-120b       # or openai/gpt-oss-20b (faster, cheaper)

# ── Fallback LLM (optional): Gemma on the Gemini API, free key at https://aistudio.google.com/apikey ──
# Used only when a Groq call fails (rate limit, broken output...). Leave GOOGLE_API_KEY out for no fallback.
GOOGLE_API_KEY=<your-google-ai-studio-key>
FALLBACK_MODEL=gemma-4-31b-it       # or gemma-4-26b-a4b-it

# ── LangSmith tracing (one project per agent) ──────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=<your-langsmith-key>
LANGCHAIN_PROJECT=shopmaster-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
